node_modules/
# Build output at the package root only. An unanchored `lib/` also swallowed
# `scripts/lib/`, which is source: the reconciler silently lost its shared
# module and CI would have failed on a clean checkout.
/lib/
research/
*.tgz
.DS_Store
npm-cache/
docs/
data/readmes-snapshot.json

# Generated when a local build enables sourcemaps; never committed (#533).
client/*.map

# Catalog copies: downloaded when needed, never committed (#545). The site
# build fetches its own into a throwaway checkout, and the market reads the
# live catalog.
data/registry-snapshot.json

# The published Arya catalog lives on the `catalog` branch. Publishing writes it
# there, and this checkout keeps only a working copy.
data/arya-plugins.json

.arya-release-artifacts/

# The plugin market index dshmarket.com mirrors (generated upstream at
# awesome-dsh-plugin.com/index.json), fetched by the site build.
data/market-index.json
